SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (not secret server keys) — donations only
REVENUECAT_API_KEY_ANDROID=your-revenuecat-android-key
REVENUECAT_API_KEY_IOS=your-revenuecat-ios-key

# Stripe publishable key (pk_...) — physical postage only. Secret key is a
# Supabase Edge Function secret (STRIPE_SECRET_KEY), never in this file.
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ---------------------------------------------------------------------------
# RevenueCat / store product ID conventions (donations — App Store + Play + RC)
# ---------------------------------------------------------------------------
# One-time donations (GBP):
#   dq_donate_5_once, dq_donate_10_once, dq_donate_25_once,
#   dq_donate_50_once, dq_donate_100_once
# Monthly subscriptions:
#   dq_donate_5_monthly, dq_donate_10_monthly, dq_donate_25_monthly,
#   dq_donate_50_monthly, dq_donate_100_monthly
#
# Attach donation products to the current RevenueCat offering.
# Custom donation amounts outside this catalogue are rejected in release.
#
# Postage (£3.99) is Stripe, not IAP. Deploy:
#   supabase functions deploy create-postage-payment
#   supabase functions deploy complete-postage-order
#   supabase functions deploy delete-account
#
# Firebase / FCM / Crashlytics (required for push + production crash reports):
#   dart pub global activate flutterfire_cli
#   flutterfire configure
# That replaces lib/core/config/firebase_options.dart placeholders and adds
# android/app/google-services.json + ios/Runner/GoogleService-Info.plist.
# Then enable Crashlytics in the Firebase console for the same project.
#
# ---------------------------------------------------------------------------
# FCM service account (Supabase Edge Function secret — NOT used by Flutter)
# ---------------------------------------------------------------------------
# Paste the Firebase Admin SDK JSON as ONE LINE (no line breaks outside \n
# inside private_key). Keep a local copy in .secrets/ (gitignored).
#
# Also set the same value in Supabase Dashboard:
#   Project → Edge Functions → Secrets → FCM_SERVICE_ACCOUNT_JSON
# Then deploy:
#   npx supabase functions deploy push-broadcast --project-ref <your-ref>
# Or: .\scripts\set-fcm-supabase-secret.ps1
#
# Example shape only — never commit a real private_key:
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project","private_key_id":"REPLACE","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com","client_id":"REPLACE","auth_uri":"https://accounts.google.com/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com","universe_domain":"googleapis.com"}
